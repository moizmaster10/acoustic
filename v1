/*
 * StructuralMonitor.ino
 * STRUCTURAL INTEGRITY MONITORING SYSTEM - ESP32 + ADXL345 (I2C 0x53)
 *
 * - Standalone Wi-Fi AP "Monitor" (192.168.4.1), dashboard served from this sketch.
 * - ADXL345 driven directly over I2C, FIFO stream mode, 200 Hz ODR, full-res +/-4 g.
 * - Window = 256 samples. Effective sampling rate is measured from exact FIFO sample
 *   counts against micros() timestamps (not assumed from a delay).
 * - Per-axis Hamming window + radix-2 FFT, combined vector spectrum.
 * - Baseline = average of several valid windows. Similarity score = 100*(1-weighted
 *   normalized deviation). EXPERIMENTAL vibration-response similarity, NOT a certified
 *   structural integrity or safety rating.
 * - Persistent storage in NVS (Preferences). Bounded: 3 objects, 3 baselines, 6 measurements.
 * - Motor is DISABLED. No motor GPIO is touched.
 *
 * Similarity formula (see compareFeat):
 *   d_rms  = min(1, |c-b| / max(c, b, NOISE_FLOOR))          same for peak
 *   d_freq = min(1, |fc-fb| / max(fb, 5 Hz))
 *   d_fft  = sum|Sc-Sb| / sum(Sc+Sb)                         64-bin magnitude spectra
 *   d_band = 0.5 * sum|Ec_i-Eb_i|                            4 relative band energies
 *   Deviation = sum(w_i*d_i) / sum(w_i over AVAILABLE features)
 *   Score = clamp(100*(1-Deviation), 0, 100)
 */

