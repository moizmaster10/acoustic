// ============================ ADXL345 ============================
bool adxlWrite(uint8_t reg, uint8_t v) {
  Wire.beginTransmission(ADXL_ADDR);
  Wire.write(reg); Wire.write(v);
  return Wire.endTransmission() == 0;
}
bool adxlRead(uint8_t reg, uint8_t* buf, uint8_t n) {
  Wire.beginTransmission(ADXL_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) return false;
  uint8_t got = Wire.requestFrom((uint8_t)ADXL_ADDR, (uint8_t)n);
  if (got != n) { while (Wire.available()) Wire.read(); return false; }
  for (uint8_t i = 0; i < n; i++) buf[i] = Wire.read();
  return true;
}
bool adxlInit() {
  uint8_t id = 0;
  if (!adxlRead(0x00, &id, 1) || id != 0xE5) return false;
  if (!adxlWrite(0x2D, 0x00)) return false;              // standby
  if (!adxlWrite(0x2E, 0x00)) return false;              // interrupts off
  if (!adxlWrite(0x2C, ADXL_RATE_CODE)) return false;    // output data rate
  if (!adxlWrite(0x31, 0x09)) return false;              // FULL_RES, +/-4 g
  if (!adxlWrite(0x38, 0x00)) return false;              // bypass (clears FIFO)
  if (!adxlWrite(0x38, 0x9F)) return false;              // stream mode
  if (!adxlWrite(0x2D, 0x08)) return false;              // measure
  delay(20);
  uint8_t chk[2], df = 0;
  if (!adxlRead(0x2C, chk, 2) || !adxlRead(0x31, &df, 1)) return false;
  return (chk[0] == ADXL_RATE_CODE && chk[1] == 0x08 && df == 0x09);
}
void sensorIdleService() {
  if (acqActive) return;
  uint32_t now = millis();
  if (!sensorOk) {
    if (now - lastReinit > 2000) {
      lastReinit = now;
      sensorOk = adxlInit();
      if (sensorOk) Serial.println("[ADXL345] (re)initialised");
    }
    return;
  }
  if (now - lastSensorPing > 250) {
    lastSensorPing = now;
    uint8_t b[6];
    if (adxlRead(0x32, b, 6)) {
      lastRaw[0] = (int16_t)((b[1] << 8) | b[0]);
      lastRaw[1] = (int16_t)((b[3] << 8) | b[2]);
      lastRaw[2] = (int16_t)((b[5] << 8) | b[4]);
      haveLast = true; lastSampleMs = now;
    } else { sensorOk = false; sensorErrors++; haveLast = false; Serial.println("[ADXL345] read failed"); }
  }
}

// ============================ ACQUISITION ============================
bool acqStart() {
  if (!sensorOk) return false;
  uint8_t st = 0; bool empty = false;
  for (int i = 0; i < 48; i++) {                         // flush FIFO
    if (!adxlRead(0x39, &st, 1)) { sensorOk = false; sensorErrors++; return false; }
    if ((st & 0x3F) == 0) { acqT0 = micros(); empty = true; break; }
    uint8_t b[6];
    if (!adxlRead(0x32, b, 6)) { sensorOk = false; sensorErrors++; return false; }
  }
  if (!empty) return false;
  uint8_t src = 0; adxlRead(0x30, &src, 1);              // clear overrun flag
  acqCount = 0; acqTotal = 0; acqClip = 0; acqMidT = 0; acqMidTotal = 0; acqLastT = acqT0;
  acqDone = false; acqErr = false; acqOverrun = false; acqActive = true;
  acqLastDataMs = millis();
  return true;
}
void acqFail() { acqErr = true; sensorOk = false; sensorErrors++; haveLast = false; }
void acqPoll() {
  if (!acqActive || acqDone || acqErr) return;
  uint8_t st = 0;
  if (!adxlRead(0x39, &st, 1)) { acqFail(); return; }
  uint32_t tS = micros();
  uint8_t entries = st & 0x3F;
  if (entries == 0) { if (millis() - acqLastDataMs > 1000) acqFail(); return; }
  uint8_t src = 0;
  if (adxlRead(0x30, &src, 1) && (src & 0x01)) acqOverrun = true;
  if (entries >= 32) acqOverrun = true;
  for (uint8_t i = 0; i < entries; i++) {
    uint8_t b[6];
    if (!adxlRead(0x32, b, 6)) { acqFail(); return; }
    int16_t x = (int16_t)((b[1] << 8) | b[0]);
    int16_t y = (int16_t)((b[3] << 8) | b[2]);
    int16_t z = (int16_t)((b[5] << 8) | b[4]);
    lastRaw[0] = x; lastRaw[1] = y; lastRaw[2] = z; haveLast = true; lastSampleMs = millis();
    if (acqCount < N_SAMP) {
      rawBuf[0][acqCount] = x; rawBuf[1][acqCount] = y; rawBuf[2][acqCount] = z;
      if (abs(x) >= CLIP_RAW || abs(y) >= CLIP_RAW || abs(z) >= CLIP_RAW) acqClip++;
      acqCount++;
    }
    acqTotal++;
  }
  acqLastT = tS; acqLastDataMs = millis();
  if (acqMidTotal == 0 && acqTotal >= N_SAMP / 2) { acqMidT = tS; acqMidTotal = acqTotal; }
  if (acqCount >= N_SAMP) acqDone = true;
}

// ============================ DSP ============================
void dspInit() {
  for (int i = 0; i < N_SAMP / 2; i++) { float a = 2.0f * PI * i / N_SAMP; twc[i] = cosf(a); tws[i] = sinf(a); }
  hwSum = 0;
  for (int i = 0; i < N_SAMP; i++) { hw[i] = 0.54f - 0.46f * cosf(2.0f * PI * i / (N_SAMP - 1)); hwSum += hw[i]; }
}
void fft(float* re, float* im) {               // in-place radix-2 DIT
  for (int i = 1, j = 0; i < N_SAMP; i++) {
    int bit = N_SAMP >> 1;
    for (; j & bit; bit >>= 1) j ^= bit;
    j ^= bit;
    if (i < j) { float t = re[i]; re[i] = re[j]; re[j] = t; t = im[i]; im[i] = im[j]; im[j] = t; }
  }
  for (int len = 2; len <= N_SAMP; len <<= 1) {
    int half = len >> 1, step = N_SAMP / len;
    for (int i = 0; i < N_SAMP; i += len) {
      for (int k = 0; k < half; k++) {
        float wr = twc[k * step], wi = -tws[k * step];
        int a = i + k, b = a + half;
        float tr = re[b] * wr - im[b] * wi;
        float ti = re[b] * wi + im[b] * wr;
        re[b] = re[a] - tr; im[b] = im[a] - ti;
        re[a] += tr;        im[a] += ti;
      }
    }
  }
}
void buildFeat(Feat& f, const float* A, float rms, float peak, float p2p, float sd, float fs) {
  memset(&f, 0, sizeof(f));
  f.rms = rms; f.peak = peak; f.p2p = p2p; f.sd = sd; f.fs = fs;
  float df = fs / N_SAMP;
  int kmin = (int)ceilf(1.0f / df); if (kmin < 2) kmin = 2;
  int kb = -1; float best = 0;
  for (int k = kmin; k < N_BINS; k++) if (A[k] > best) { best = A[k]; kb = k; }
  if (kb < 0 || best <= 0) f.domF = NAN;
  else {
    float fr = (float)kb;
    if (kb > kmin && kb < N_BINS - 1) {
      float a = A[kb - 1], b = A[kb], c = A[kb + 1], den = a - 2 * b + c;
      if (fabsf(den) > 1e-12f) { float d = 0.5f * (a - c) / den; if (d > -1 && d < 1) fr += d; }
    }
    f.domF = fr * df;
  }
  float e[N_BANDS] = {0, 0, 0, 0}, tot = 0;
  for (int k = 1; k <= N_BINS; k++) {
    float p = A[k] * A[k]; tot += p;
    float fr = k * df; int b = 3;
    if (fr < BAND_EDGE[0]) b = 0; else if (fr < BAND_EDGE[1]) b = 1; else if (fr < BAND_EDGE[2]) b = 2;
    e[b] += p;
  }
  for (int b = 0; b < N_BANDS; b++) f.band[b] = (tot > 0) ? e[b] / tot : NAN;
  float s[N_SPEC], mx = 0;
  for (int j = 0; j < N_SPEC; j++) { float a = A[2 * j], b = A[2 * j + 1]; s[j] = sqrtf(0.5f * (a * a + b * b)); if (s[j] > mx) mx = s[j]; }
  f.specMax = mx;
  for (int j = 0; j < N_SPEC; j++) f.spec[j] = (mx > 0) ? (uint8_t)lroundf(s[j] / mx * 255.0f) : 0;
}

// ---- similarity ----
float relDev(float a, float b) {
  if (!isfinite(a) || !isfinite(b)) return NAN;
  float den = fmaxf(fmaxf(a, b), NOISE_FLOOR);
  return fminf(1.0f, fabsf(a - b) / den);
}
bool compareFeat(const Feat& c, const Feat& b, float& score, float* dev) {
  for (int i = 0; i < 5; i++) dev[i] = NAN;
  score = NAN;
  if (!(b.fs > 0) || !(c.fs > 0) || fabsf(c.fs - b.fs) / b.fs > 0.15f) return false;
  dev[0] = relDev(c.rms, b.rms);
  dev[1] = relDev(c.peak, b.peak);
  if (isfinite(c.domF) && isfinite(b.domF) && b.domF > 0) dev[2] = fminf(1.0f, fabsf(c.domF - b.domF) / fmaxf(b.domF, 5.0f));
  float sa = 0, ss = 0;
  for (int j = 0; j < N_SPEC; j++) { float x = specAt(c, j), y = specAt(b, j); sa += fabsf(x - y); ss += x + y; }
  if (ss > 0) dev[3] = fminf(1.0f, sa / ss);
  bool okb = true; float sb = 0;
  for (int i = 0; i < N_BANDS; i++) { if (!isfinite(c.band[i]) || !isfinite(b.band[i])) { okb = false; break; } sb += fabsf(c.band[i] - b.band[i]); }
  if (okb) dev[4] = fminf(1.0f, 0.5f * sb);
  float sw = 0, sd = 0;
  for (int i = 0; i < 5; i++) if (isfinite(dev[i])) { sw += W_FEAT[i]; sd += W_FEAT[i] * dev[i]; }
  if (sw <= 0) return false;
  float s = 100.0f * (1.0f - sd / sw);
  if (s < 0) s = 0; if (s > 100) s = 100;
  score = s;
  return true;
}

void clearResult() { memset(&cur, 0, sizeof(cur)); haveWin = false; }

