}

void processWindow() {
  const float K = ACC_LSB_MS2;
  float mean[3] = {0, 0, 0};
  int16_t rmn[3] = {32767, 32767, 32767}, rmx[3] = {-32768, -32768, -32768};
  for (int a = 0; a < 3; a++) {
    for (int i = 0; i < N_SAMP; i++) { int16_t v = rawBuf[a][i]; mean[a] += v; if (v < rmn[a]) rmn[a] = v; if (v > rmx[a]) rmx[a] = v; }
    mean[a] /= N_SAMP;
  }
  bool stuck = (rmn[0] == rmx[0] && rmn[1] == rmx[1] && rmn[2] == rmx[2]);
  float* dst[3] = {wx, wy, wz};
  float axSq[3] = {0, 0, 0}, mn[3] = {1e9f, 1e9f, 1e9f}, mx[3] = {-1e9f, -1e9f, -1e9f};
  float sumSq = 0, sumRes = 0, peak = 0;
  for (int i = 0; i < N_SAMP; i++) {
    float d[3];
    for (int a = 0; a < 3; a++) {
      d[a] = ((float)rawBuf[a][i] - mean[a]) * K;       // DC / gravity / bias removed
      dst[a][i] = d[a]; axSq[a] += d[a] * d[a];
      if (d[a] < mn[a]) mn[a] = d[a]; if (d[a] > mx[a]) mx[a] = d[a];
    }
    float r2 = d[0] * d[0] + d[1] * d[1] + d[2] * d[2], r = sqrtf(r2);
    sumSq += r2; sumRes += r; if (r > peak) peak = r;
  }
  float rms = sqrtf(sumSq / N_SAMP), mr = sumRes / N_SAMP;
  float var = sumSq / N_SAMP - mr * mr, sd = var > 0 ? sqrtf(var) : 0;
  float p2p = 0;
  for (int a = 0; a < 3; a++) { cur.axRms[a] = sqrtf(axSq[a] / N_SAMP); cur.axP2p[a] = mx[a] - mn[a]; if (cur.axP2p[a] > p2p) p2p = cur.axP2p[a]; }
  float gmag = K * sqrtf(mean[0] * mean[0] + mean[1] * mean[1] + mean[2] * mean[2]);

  // FFT per axis (Hamming), combined vector amplitude spectrum
  float P[N_BINS + 1];
  for (int k = 0; k <= N_BINS; k++) P[k] = 0;
  for (int a = 0; a < 3; a++) {
    for (int i = 0; i < N_SAMP; i++) { fre[i] = dst[a][i] * hw[i]; fim[i] = 0; }
    fft(fre, fim);
    for (int k = 0; k <= N_BINS; k++) P[k] += fre[k] * fre[k] + fim[k] * fim[k];
  }
  for (int k = 0; k <= N_BINS; k++) curA[k] = (k == 0) ? 0 : 2.0f * sqrtf(P[k]) / hwSum;

  // timing from exact FIFO counts
  float dt = (float)(uint32_t)(acqLastT - acqT0) * 1e-6f;
  float fsEff = (dt > 0) ? (float)acqTotal / dt : NAN;
  bool irreg = false;
  if (acqMidTotal > 0 && acqMidT > acqT0 && acqLastT > acqMidT && acqTotal > acqMidTotal + 20 && isfinite(fsEff)) {
    float f1 = acqMidTotal / ((float)(acqMidT - acqT0) * 1e-6f);
    float f2 = (acqTotal - acqMidTotal) / ((float)(acqLastT - acqMidT) * 1e-6f);
    if (fabsf(f1 - f2) / fsEff > 0.15f) irreg = true;
  }
  float tdev = isfinite(fsEff) ? fabsf(fsEff - FS_NOMINAL) / FS_NOMINAL : 9.0f;

  uint16_t fl = 0;
  if (acqOverrun) fl |= F_OVERRUN;
  if (acqClip > 0) fl |= F_CLIP;
  if (tdev > 0.05f) fl |= F_TIMING;
  if (irreg) fl |= F_IRREG;
  if (rms < LOWSIG_RMS) fl |= F_LOWSIG;
  if (gmag < 7.5f || gmag > 12.3f) fl |= F_GRAV;
  if (stuck) fl |= F_STUCK;
  uint8_t q = Q_GOOD;
  if (fl & (F_LOWSIG | F_GRAV | F_TIMING)) q = Q_ACCEPTABLE;
  if (tdev > 0.12f || irreg || acqClip > 0) q = Q_POOR;
  if (stuck || acqOverrun || tdev > 0.30f || acqClip > N_SAMP / 20 || !isfinite(fsEff)) q = Q_INVALID;

  cur.winId = ++winCounter; cur.measId = nextMeasId; cur.ts = epochNow();
  cur.quality = q; cur.flags = fl; cur.clip = acqClip; cur.fsEff = fsEff; cur.gmag = gmag;
  buildFeat(cur.f, curA, rms, peak, p2p, sd, isfinite(fsEff) ? fsEff : FS_NOMINAL);
  cur.hasScore = false; cur.score = NAN; cur.baseId = 0;
  for (int i = 0; i < 5; i++) cur.dev[i] = NAN;
  if (q == Q_INVALID) cur.state = 3;
  else if (mode == M_BASELINE) cur.state = 2;
  else if (activeObj < 0 || !baseValid[activeObj]) cur.state = 2;
  else {
    float sc;
    cur.baseId = baseCache[activeObj].id;
    if (compareFeat(cur.f, baseCache[activeObj].f, sc, cur.dev)) { cur.hasScore = true; cur.score = sc; cur.state = 1; }
    else cur.state = 4;
  }
  dataWin = cur.winId; haveWin = true;
}

// ============================ BASELINE ============================
void blReset() {
  blAccepted = 0; blRejected = 0;
  for (int i = 0; i < 5; i++) blSum[i] = 0;
  for (int k = 0; k <= N_BINS; k++) blSumA[k] = 0;
}
bool finalizeBaseline() {
  mode = M_IDLE; acqActive = false;
  if (blAccepted < BL_MIN_WIN) {
    blPhase = BL_IDLE; blCandValid = false;
    blMsg = "Incomplete baseline rejected: " + String(blAccepted) + " valid window(s) recorded, minimum is " + String(BL_MIN_WIN) + ".";
    return false;
  }
  float n = blAccepted, A[N_BINS + 1];
  for (int k = 0; k <= N_BINS; k++) A[k] = blSumA[k] / n;
  memset(&blCand, 0, sizeof(blCand));
  blCand.magic = MAGIC_BASE; blCand.id = nextBaseId; blCand.ts = epochNow(); blCand.windows = blAccepted;
  buildFeat(blCand.f, A, blSum[0] / n, blSum[1] / n, blSum[2] / n, blSum[3] / n, blSum[4] / n);
  if (!(blCand.f.rms > 0) || !(blCand.f.fs > 0)) {
    blPhase = BL_IDLE; blCandValid = false; blMsg = "Baseline rejected: no usable vibration signal."; return false;
  }
  blCandValid = true; blPhase = BL_REVIEW; blMsg = "Baseline recorded. Review it, then save or re-record.";
  return true;
}
void baselineWindowDone() {
  if (cur.quality >= Q_ACCEPTABLE) {
    blSum[0] += cur.f.rms; blSum[1] += cur.f.peak; blSum[2] += cur.f.p2p; blSum[3] += cur.f.sd; blSum[4] += cur.f.fs;
    for (int k = 0; k <= N_BINS; k++) blSumA[k] += curA[k];
    blAccepted++;
  } else blRejected++;
  if (blAccepted >= BL_MAX_WIN) finalizeBaseline();
  else if (blRejected >= BL_MAX_REJECT) {
    mode = M_IDLE; blPhase = BL_IDLE; blCandValid = false;
    blMsg = "Baseline aborted: too many invalid windows. Check mounting, wiring and excitation.";
  }
}
void finishWindow() {
  acqActive = false;
  if (acqErr || acqCount < N_SAMP) makeInvalid(acqErr ? F_SENSOR : F_SHORT);
  else processWindow();
  if (mode == M_BASELINE) baselineWindowDone();
}

// ============================ STORAGE ============================
bool saveMeasurement(uint32_t& idOut, String& err) {
  if (!storageOk) { err = "Storage unavailable"; return false; }
  if (activeObj < 0) { err = "No object selected"; return false; }
  if (cur.winId <= testStartWin || cur.quality == Q_INVALID || !isfinite(cur.f.rms)) { err = "No valid completed measurement to save"; return false; }
  int slot = -1, oldestSlot = 0; uint32_t oldest = 0xFFFFFFFFUL;
  for (int i = 0; i < MAX_HIST; i++) {
    if (!histValid[i]) { slot = i; break; }
    if (hist[i].id < oldest) { oldest = hist[i].id; oldestSlot = i; }
  }
  if (slot < 0) slot = oldestSlot;
  MeasRec m; memset(&m, 0, sizeof(m));
  m.magic = MAGIC_MEAS; m.id = nextMeasId; m.ts = cur.ts; m.baseId = cur.baseId;
  m.score = cur.hasScore ? cur.score : NAN; m.hasScore = cur.hasScore;
  for (int i = 0; i < 5; i++) m.dev[i] = cur.dev[i];
  m.quality = cur.quality; m.obj = (uint8_t)activeObj; m.flags = cur.flags; m.clip = cur.clip; m.samples = N_SAMP; m.f = cur.f;
  char key[8]; snprintf(key, sizeof(key), "m%d", slot);
  if (prefs.putBytes(key, &m, sizeof(m)) != sizeof(m)) { err = "Flash write failed"; return false; }
  hist[slot] = m; histValid[slot] = true; idOut = m.id;
  nextMeasId++; prefs.putUInt("nmid", nextMeasId);
  cur.measId = nextMeasId;
  return true;
}
String objGet(int slot, int idx) {
  const String& p = objPack[slot];
  int start = 0;
  for (int i = 0; i < idx; i++) { int q = p.indexOf((char)0x1F, start); if (q < 0) return ""; start = q + 1; }
  int e = p.indexOf((char)0x1F, start);
  return e < 0 ? p.substring(start) : p.substring(start, e);
}
void purgeObject(int slot) {
  char key[8];
  snprintf(key, sizeof(key), "o%d", slot); prefs.remove(key);
  snprintf(key, sizeof(key), "b%d", slot); prefs.remove(key);
  objPack[slot] = ""; objUsed[slot] = false; baseValid[slot] = false;
  for (int h = 0; h < MAX_HIST; h++) if (histValid[h] && hist[h].obj == slot) {
    snprintf(key, sizeof(key), "m%d", h); prefs.remove(key); histValid[h] = false;
  }
  if (activeObj == slot) {
    activeObj = -1;
    for (int i = 0; i < MAX_OBJ; i++) if (objUsed[i]) { activeObj = i; break; }
    prefs.putChar("act", activeObj);
  }
  clearResult();
}
void loadStorage() {
  for (int i = 0; i < MAX_OBJ; i++) { objUsed[i] = false; baseValid[i] = false; }
  for (int i = 0; i < MAX_HIST; i++) histValid[i] = false;
  storageOk = prefs.begin("shm", false);
  if (!storageOk) { Serial.println("[NVS] open failed"); return; }
  nextMeasId = prefs.getUInt("nmid", 1); nextBaseId = prefs.getUInt("nbid", 1);
  activeObj = prefs.getChar("act", -1);
  char key[8];
  for (int i = 0; i < MAX_OBJ; i++) {
    snprintf(key, sizeof(key), "o%d", i);
    if (prefs.isKey(key)) { objPack[i] = prefs.getString(key, ""); objUsed[i] = objPack[i].length() > 0; }
  }
  for (int i = 0; i < MAX_OBJ; i++) {
    snprintf(key, sizeof(key), "b%d", i);
    if (prefs.isKey(key) && prefs.getBytesLength(key) == sizeof(BaseRec)) {
      prefs.getBytes(key, &baseCache[i], sizeof(BaseRec));
      baseValid[i] = (baseCache[i].magic == MAGIC_BASE) && objUsed[i];
    }
  }
  for (int i = 0; i < MAX_HIST; i++) {
    snprintf(key, sizeof(key), "m%d", i);
    if (prefs.isKey(key) && prefs.getBytesLength(key) == sizeof(MeasRec)) {
      prefs.getBytes(key, &hist[i], sizeof(MeasRec));
      histValid[i] = (hist[i].magic == MAGIC_MEAS) && hist[i].obj < MAX_OBJ && objUsed[hist[i].obj];
    }
  }
  if (activeObj < 0 || activeObj >= MAX_OBJ || !objUsed[activeObj]) {
    activeObj = -1;
    for (int i = 0; i < MAX_OBJ; i++) if (objUsed[i]) { activeObj = i; break; }
  }
  Serial.printf("[NVS] loaded: objects/baselines/measurements restored, active=%d\n", activeObj);
}

// ============================ JSON BUILDERS ============================
String featJson(const Feat& f, bool withSpec) {
  String s; s.reserve(withSpec ? 700 : 260);
  s += "{\"rms\":" + jnum(f.rms, 4) + ",\"peak\":" + jnum(f.peak, 4) + ",\"p2p\":" + jnum(f.p2p, 4) +
       ",\"sd\":" + jnum(f.sd, 4) + ",\"domF\":" + jnum(f.domF, 2) + ",\"fs\":" + jnum(f.fs, 2) + ",\"band\":[";
  for (int b = 0; b < N_BANDS; b++) { s += jnum(f.band[b], 4); if (b < N_BANDS - 1) s += ","; }
  s += "]";
  if (withSpec) {
    s += ",\"spec\":[";
    for (int j = 0; j < N_SPEC; j++) { s += jnum(specAt(f, j), 4); if (j < N_SPEC - 1) s += ","; }
    s += "]";
  }
  return s + "}";
}
String devJson(const float* dev) {
  String s = "[";
  for (int i = 0; i < 5; i++) {
    s += "{\"n\":" + jstr(FEAT_NAMES[i]) + ",\"d\":" + jnum(dev[i], 4) + ",\"w\":" + jnum(W_FEAT[i], 2) + "}";
    if (i < 4) s += ",";
  }
  return s + "]";
}
String resultJson() {
  if (cur.winId == 0) return "null";
  String s; s.reserve(1000);
  s += "{\"win\":" + U(cur.winId) + ",\"meas\":" + U(cur.measId) + ",\"ts\":" + U(cur.ts) +
       ",\"quality\":" + jstr(qName(cur.quality)) + ",\"issues\":" + issuesJson(cur.flags) +
       ",\"state\":" + jstr(stateName(cur.state)) +
       ",\"score\":" + (cur.hasScore ? jnum(cur.score, 1) : String("null")) +
       ",\"cat\":" + (cur.hasScore ? jstr(scoreCat(cur.score)) : String("null")) +
       ",\"baseId\":" + U(cur.baseId) + ",\"dev\":" + devJson(cur.dev) +
       ",\"rms\":" + jnum(cur.f.rms, 4) + ",\"peak\":" + jnum(cur.f.peak, 4) + ",\"p2p\":" + jnum(cur.f.p2p, 4) +
       ",\"sd\":" + jnum(cur.f.sd, 4) + ",\"domF\":" + jnum(cur.f.domF, 2) + ",\"fs\":" + jnum(cur.fsEff, 2) +
       ",\"dur\":" + jnum(isfinite(cur.fsEff) && cur.fsEff > 0 ? N_SAMP / cur.fsEff : NAN, 3) +
       ",\"n\":" + String(N_SAMP) + ",\"clip\":" + U(cur.clip) + ",\"gmag\":" + jnum(cur.gmag, 2) + "}";
  return s;
}
String objectBrief(int slot) {
  return "{\"slot\":" + String(slot) + ",\"name\":" + jstr(objGet(slot, 0)) + ",\"oid\":" + jstr(objGet(slot, 1)) +
         ",\"hasBaseline\":" + jbool(baseValid[slot]) + ",\"baseId\":" + U(baseValid[slot] ? baseCache[slot].id : 0) +
         ",\"baseTs\":" + U(baseValid[slot] ? baseCache[slot].ts : 0) + "}";
}
String baseJson(const BaseRec& b) {
  return "{\"id\":" + U(b.id) + ",\"ts\":" + U(b.ts) + ",\"windows\":" + U(b.windows) + ",\"f\":" + featJson(b.f, true) + "}";
}

// ============================ HTTP HANDLERS ============================
extern const char HTML_A[] PROGMEM;
extern const char HTML_B[] PROGMEM;
extern const char HTML_C[] PROGMEM;

void sendPgm(const char* p) {
  size_t len = strlen_P(p), off = 0;
  while (off < len) {
    size_t n = len - off; if (n > 1400) n = 1400;
    server.sendContent_P(p + off, n);
    off += n;
    acqPoll();                       // keep draining the ADXL345 FIFO while serving the page
  }
}
void handleRoot() {
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.sendHeader("Cache-Control", "no-cache");
  server.send(200, "text/html", "");
  sendPgm(HTML_A); sendPgm(HTML_B); sendPgm(HTML_C);
  server.sendContent("");
}
void handleStatus() {
  if (server.hasArg("t")) {
    uint32_t t = strtoul(server.arg("t").c_str(), NULL, 10);
    if (t > 1500000000UL) {
      uint32_t e = epochNow();
      if (!timeSynced || (t > e ? t - e : e - t) > 2) { epochBase = t; epochSyncMs = millis(); timeSynced = true; }
    }
  }
  String s; s.reserve(1800);
  s += "{\"ok\":true,\"uptime\":" + U(millis() / 1000) + ",\"ts\":" + U(epochNow()) + ",\"storage\":" + jbool(storageOk);
  s += ",\"wifi\":{\"ssid\":" + jstr(AP_SSID) + ",\"ip\":" + jstr(WiFi.softAPIP().toString()) + ",\"clients\":" + String(WiFi.softAPgetStationNum()) + "}";
  s += ",\"sensor\":{\"ok\":" + jbool(sensorOk) + ",\"model\":\"ADXL345\",\"addr\":\"0x53\",\"odr\":" + String((int)FS_NOMINAL) + ",\"range\":4,\"errors\":" + U(sensorErrors) + "}";
  s += ",\"mode\":" + String(mode == M_TEST ? "\"test\"" : mode == M_BASELINE ? "\"baseline\"" : "\"idle\"");
  s += ",\"phase\":" + String(blPhase == BL_REC ? "\"recording\"" : blPhase == BL_REVIEW ? "\"review\"" : "\"idle\"");
  s += ",\"acq\":{\"count\":" + U(acqActive ? acqCount : 0) + ",\"n\":" + String(N_SAMP) + "}";
  s += ",\"bl\":{\"accepted\":" + String(blAccepted) + ",\"rejected\":" + String(blRejected) + ",\"min\":" + String(BL_MIN_WIN) + ",\"max\":" + String(BL_MAX_WIN) + ",\"msg\":" + jstr(blMsg) + "}";
  s += ",\"object\":" + ((activeObj >= 0 && objUsed[activeObj]) ? objectBrief(activeObj) : String("null"));
  s += ",\"motor\":{\"state\":\"DISABLED\",\"rpm\":\"NOT MEASURED\",\"current\":\"NOT MEASURED\"}";
  s += ",\"result\":" + resultJson() + "}";
  sendJson(200, s);
}
void handleSensor() {
  bool conn = sensorOk && haveLast;
  String s = "{\"ok\":true,\"connected\":" + jbool(sensorOk) + ",\"errors\":" + U(sensorErrors);
  if (conn) {
    float x = lastRaw[0] * ACC_LSB_MS2, y = lastRaw[1] * ACC_LSB_MS2, z = lastRaw[2] * ACC_LSB_MS2;
    s += ",\"x\":" + jnum(x, 3) + ",\"y\":" + jnum(y, 3) + ",\"z\":" + jnum(z, 3) +
         ",\"mag\":" + jnum(sqrtf(x * x + y * y + z * z), 3) + ",\"age\":" + U(millis() - lastSampleMs);
  } else s += ",\"x\":null,\"y\":null,\"z\":null,\"mag\":null,\"age\":null";
  sendJson(200, s + "}");
}
void handleData() {
  if (!haveWin) { sendJson(200, "{\"ok\":true,\"has\":false}"); return; }
  long since = server.hasArg("since") ? server.arg("since").toInt() : -1;
  if (since == (long)dataWin) { sendJson(200, "{\"ok\":true,\"has\":true,\"changed\":false,\"win\":" + U(dataWin) + "}"); return; }
  float fs = (isfinite(cur.fsEff) && cur.fsEff > 0) ? cur.fsEff : FS_NOMINAL;
  String s; s.reserve(11000);
  s += "{\"ok\":true,\"has\":true,\"changed\":true,\"win\":" + U(dataWin) + ",\"fs\":" + jnum(fs, 2) + ",\"df\":" + jnum(fs / N_SAMP, 4) +
       ",\"n\":" + String(N_SAMP) + ",\"quality\":" + jstr(qName(cur.quality));
  const float* arr[3] = {wx, wy, wz}; const char* nm[3] = {"x", "y", "z"};
  for (int a = 0; a < 3; a++) {
    s += ",\"" + String(nm[a]) + "\":[";
    for (int i = 0; i < N_SAMP; i++) { s += String(arr[a][i], 3); if (i < N_SAMP - 1) s += ","; }
    s += "]";
  }
  s += ",\"spec\":[";
  for (int k = 0; k <= N_BINS; k++) { s += String(curA[k], 4); if (k < N_BINS) s += ","; }
  s += "],\"cur64\":[";
  for (int j = 0; j < N_SPEC; j++) { s += jnum(specAt(cur.f, j), 4); if (j < N_SPEC - 1) s += ","; }
  s += "],\"f\":" + featJson(cur.f, false);
  s += ",\"ax\":{\"rms\":[" + jnum(cur.axRms[0], 4) + "," + jnum(cur.axRms[1], 4) + "," + jnum(cur.axRms[2], 4) +
       "],\"p2p\":[" + jnum(cur.axP2p[0], 4) + "," + jnum(cur.axP2p[1], 4) + "," + jnum(cur.axP2p[2], 4) + "]}";
  if (activeObj >= 0 && baseValid[activeObj]) {
    const Feat& bf = baseCache[activeObj].f;
    s += ",\"base\":" + featJson(bf, false) + ",\"base64\":[";
    for (int j = 0; j < N_SPEC; j++) { s += jnum(specAt(bf, j), 4); if (j < N_SPEC - 1) s += ","; }
    s += "]";
  } else s += ",\"base\":null,\"base64\":null";
  s += "}";
  sendJson(200, s);
}
void handleBaselineGet() {
  String s; s.reserve(2500);
  s += "{\"ok\":true,\"phase\":" + String(blPhase == BL_REC ? "\"recording\"" : blPhase == BL_REVIEW ? "\"review\"" : "\"idle\"");
  s += ",\"msg\":" + jstr(blMsg);
  s += ",\"progress\":{\"accepted\":" + String(blAccepted) + ",\"rejected\":" + String(blRejected) + ",\"min\":" + String(BL_MIN_WIN) +
       ",\"max\":" + String(BL_MAX_WIN) + ",\"count\":" + U(acqActive ? acqCount : 0) + ",\"n\":" + String(N_SAMP) + "}";
  s += ",\"active\":" + String((int)activeObj) + ",\"objects\":[";
  bool first = true;
  for (int i = 0; i < MAX_OBJ; i++) if (objUsed[i]) { if (!first) s += ","; s += objectBrief(i); first = false; }
  s += "],\"saved\":" + ((activeObj >= 0 && baseValid[activeObj]) ? baseJson(baseCache[activeObj]) : String("null"));
  s += ",\"candidate\":" + ((blPhase == BL_REVIEW && blCandValid) ? baseJson(blCand) : String("null")) + "}";
  sendJson(200, s);
}
void handleTestStart() {
  if (mode != M_IDLE) { sendErr(409, mode == M_TEST ? "Test already running" : "Baseline recording in progress - stop it first"); return; }
  if (activeObj < 0 || !objUsed[activeObj]) { sendErr(409, "Create/select an object profile first"); return; }
  if (!sensorOk) { sendErr(503, "ADXL345 not detected - check wiring"); return; }
  testStartWin = winCounter;
  if (!acqStart()) { sendErr(503, "Could not start acquisition - sensor error"); return; }
  mode = M_TEST;
  sendOk();
}
void handleTestStop() {
  if (mode != M_TEST) { sendErr(409, "No test running"); return; }
  acqActive = false; mode = M_IDLE;
  uint32_t id = 0; String err;
  if (saveMeasurement(id, err)) sendOk(",\"saved\":true,\"id\":" + U(id));
  else sendOk(",\"saved\":false,\"reason\":" + jstr(err));
}
void handleBaselineStart() {
  if (mode == M_TEST) { sendErr(409, "Stop the running test first"); return; }
  if (activeObj < 0 || !objUsed[activeObj]) { sendErr(409, "Create/select an object profile first"); return; }
  if (!sensorOk) { sendErr(503, "ADXL345 not detected - check wiring"); return; }
  blReset(); blCandValid = false; blObj = activeObj; blMsg = "Recording baseline - excite the object consistently.";
  if (!acqStart()) { sendErr(503, "Could not start acquisition - sensor error"); return; }
  mode = M_BASELINE; blPhase = BL_REC; clearResult();
  sendOk();
}
void handleBaselineStop() {
  bool cancel = server.arg("cancel") == "1";
  if (blPhase == BL_REC) {
    if (cancel) { mode = M_IDLE; acqActive = false; blPhase = BL_IDLE; blCandValid = false; blMsg = "Baseline recording cancelled."; sendOk(); return; }
    bool ok = finalizeBaseline();
    if (!ok) { sendErr(422, blMsg); return; }
    sendOk(); return;
  }
  if (blPhase == BL_REVIEW && cancel) { blPhase = BL_IDLE; blCandValid = false; blMsg = "Baseline discarded."; sendOk(); return; }
  sendErr(409, "No baseline recording in progress");
}
void handleBaselineSave() {
  if (blPhase != BL_REVIEW || !blCandValid) { sendErr(409, "No reviewed baseline to save"); return; }
  if (!storageOk) { sendErr(500, "Storage unavailable"); return; }
  if (blObj < 0 || !objUsed[blObj]) { sendErr(409, "Object no longer exists"); return; }
  char key[8]; snprintf(key, sizeof(key), "b%d", blObj);
  if (prefs.putBytes(key, &blCand, sizeof(BaseRec)) != sizeof(BaseRec)) { sendErr(500, "Flash write failed - baseline not saved"); return; }
  baseCache[blObj] = blCand; baseValid[blObj] = true;
  nextBaseId++; prefs.putUInt("nbid", nextBaseId);
  blPhase = BL_IDLE; blCandValid = false; blMsg = "Baseline saved."; clearResult();
  sendOk();
}
void handleObjectGet() {
  String s; s.reserve(2500);
  s += "{\"ok\":true,\"active\":" + String((int)activeObj) + ",\"max\":" + String(MAX_OBJ) + ",\"objects\":[";
  bool first = true;
  for (int i = 0; i < MAX_OBJ; i++) if (objUsed[i]) {
    if (!first) s += ","; first = false;
    s += "{\"slot\":" + String(i) + ",\"hasBaseline\":" + jbool(baseValid[i]) + ",\"baseId\":" + U(baseValid[i] ? baseCache[i].id : 0) + ",\"f\":{";
    for (int k = 0; k < 17; k++) { s += "\"" + String(OBJ_FIELDS[k]) + "\":" + jstr(objGet(i, k)); if (k < 16) s += ","; }
    s += "}}";
  }
  sendJson(200, s + "]}");
}
String cleanVal(String v) {
  v.trim();
  for (size_t i = 0; i < v.length(); i++) if ((uint8_t)v[i] < 0x20) v.setCharAt(i, ' ');
  if (v.length() > 64) v = v.substring(0, 64);
  return v;
}
void handleObjectSave() {
  if (!storageOk) { sendErr(500, "Storage unavailable"); return; }
  String vals[17];
  for (int i = 0; i < 17; i++) vals[i] = cleanVal(server.arg(OBJ_FIELDS[i]));
  if (vals[0].length() == 0 || vals[1].length() == 0) { sendErr(400, "Object name and Object ID are required"); return; }
  const int numIdx[4] = {3, 4, 5, 7};
  for (int n = 0; n < 4; n++) {
    int i = numIdx[n];
    if (vals[i].length()) {
      char* e; double d = strtod(vals[i].c_str(), &e);
      if (*e != 0 || !isfinite(d) || d < 0 || d > 1000000.0) { sendErr(400, String(OBJ_FIELDS[i]) + " must be a non-negative number"); return; }
    }
  }
  bool matOk = false;
  for (int m = 0; m < 7; m++) if (vals[6] == MATERIALS[m]) matOk = true;
  if (!matOk) { sendErr(400, "Select a valid material"); return; }
  int slot = -1;
  if (server.hasArg("slot") && server.arg("slot").length()) slot = server.arg("slot").toInt();
  if (slot < -1 || slot >= MAX_OBJ) { sendErr(400, "Invalid slot"); return; }
  if (slot >= 0 && !objUsed[slot]) { sendErr(404, "Unknown profile slot"); return; }
  if (slot < 0) {
    for (int i = 0; i < MAX_OBJ; i++) if (!objUsed[i]) { slot = i; break; }
    if (slot < 0) { sendErr(409, "Object storage full (max " + String(MAX_OBJ) + "). Delete a profile first."); return; }
  }
  String packed;
  for (int i = 0; i < 17; i++) { packed += vals[i]; if (i < 16) packed += (char)0x1F; }
  char key[8]; snprintf(key, sizeof(key), "o%d", slot);
  if (prefs.putString(key, packed) == 0) { sendErr(500, "Flash write failed - profile not saved"); return; }
  objPack[slot] = packed; objUsed[slot] = true;
  if (activeObj < 0) { activeObj = slot; prefs.putChar("act", activeObj); clearResult(); }
  sendOk(",\"slot\":" + String(slot));
}
void handleObjectSelect() {
  if (mode != M_IDLE || blPhase != BL_IDLE) { sendErr(409, "Finish or cancel the running test/baseline first"); return; }
  int slot = server.arg("slot").toInt();
  if (!server.hasArg("slot") || slot < 0 || slot >= MAX_OBJ || !objUsed[slot]) { sendErr(400, "Invalid object slot"); return; }
  activeObj = slot;
  if (storageOk) prefs.putChar("act", activeObj);
  clearResult();
  sendOk();
}
void handleObjectDelete() {
  if (mode != M_IDLE || blPhase != BL_IDLE) { sendErr(409, "Finish or cancel the running test/baseline first"); return; }
  int slot = server.arg("slot").toInt();
  if (!server.hasArg("slot") || slot < 0 || slot >= MAX_OBJ || !objUsed[slot]) { sendErr(400, "Invalid object slot"); return; }
  purgeObject(slot);
  sendOk();
}
void handleHistory() {
  if (server.hasArg("id")) {
    uint32_t id = strtoul(server.arg("id").c_str(), NULL, 10);
    int h = -1;
    for (int i = 0; i < MAX_HIST; i++) if (histValid[i] && hist[i].id == id) h = i;
    if (h < 0) { sendErr(404, "Measurement not found"); return; }
    const MeasRec& m = hist[h];
    String s; s.reserve(3000);
    s += "{\"ok\":true,\"m\":{\"id\":" + U(m.id) + ",\"ts\":" + U(m.ts) + ",\"obj\":" + String(m.obj) + ",\"objName\":" + jstr(objGet(m.obj, 0)) +
         ",\"quality\":" + jstr(qName(m.quality)) + ",\"issues\":" + issuesJson(m.flags) + ",\"score\":" + (m.hasScore ? jnum(m.score, 1) : String("null")) +
         ",\"cat\":" + (m.hasScore ? jstr(scoreCat(m.score)) : String("null")) + ",\"baseId\":" + U(m.baseId) + ",\"dev\":" + devJson(m.dev) +
         ",\"clip\":" + U(m.clip) + ",\"samples\":" + U(m.samples) + ",\"f\":" + featJson(m.f, true) + "}";
    if (baseValid[m.obj]) {
      float sc, dev[5];
      bool ok = compareFeat(m.f, baseCache[m.obj].f, sc, dev) && m.quality != Q_INVALID;
      s += ",\"baseline\":" + baseJson(baseCache[m.obj]);
      s += ",\"cmp\":{\"ok\":" + jbool(ok) + ",\"score\":" + (ok ? jnum(sc, 1) : String("null")) + ",\"cat\":" + (ok ? jstr(scoreCat(sc)) : String("null")) +
           ",\"dev\":" + devJson(ok ? dev : m.dev) + "}";
    } else s += ",\"baseline\":null,\"cmp\":null";
    sendJson(200, s + "}");
    return;
  }
  String s; s.reserve(2000);
  s += "{\"ok\":true,\"max\":" + String(MAX_HIST) + ",\"items\":[";
  bool first = true;
  for (int i = 0; i < MAX_HIST; i++) if (histValid[i]) {
    const MeasRec& m = hist[i];
    if (!first) s += ","; first = false;
    s += "{\"id\":" + U(m.id) + ",\"ts\":" + U(m.ts) + ",\"obj\":" + String(m.obj) + ",\"objName\":" + jstr(objGet(m.obj, 0)) +
         ",\"score\":" + (m.hasScore ? jnum(m.score, 1) : String("null")) + ",\"cat\":" + (m.hasScore ? jstr(scoreCat(m.score)) : String("null")) +
         ",\"quality\":" + jstr(qName(m.quality)) + ",\"rms\":" + jnum(m.f.rms, 4) + ",\"peak\":" + jnum(m.f.peak, 4) +
         ",\"domF\":" + jnum(m.f.domF, 2) + ",\"fs\":" + jnum(m.f.fs, 1) + ",\"baseId\":" + U(m.baseId) + "}";
  }
  sendJson(200, s + "]}");
}
void handleHistoryDelete() {
  uint32_t id = strtoul(server.arg("id").c_str(), NULL, 10);
  for (int i = 0; i < MAX_HIST; i++) if (histValid[i] && hist[i].id == id) {
    char key[8]; snprintf(key, sizeof(key), "m%d", i);
    if (storageOk) prefs.remove(key);
    histValid[i] = false;
    sendOk(); return;
  }
  sendErr(404, "Measurement not found");
}
String csvq(const String& v) { String o = "\""; for (size_t i = 0; i < v.length(); i++) { if (v[i] == '"') o += "\"\""; else o += v[i]; } return o + "\""; }
void handleExport() {
  String s; s.reserve(16000);
  String fname;
  if (server.arg("type") == "history") {
    fname = "history.csv";
    s += "measurement_id,timestamp_epoch,object_name,baseline_id,similarity_score,category,quality,rms_ms2,peak_ms2,p2p_ms2,std_ms2,dominant_hz,fs_hz,samples,band1,band2,band3,band4\r\n";
    for (int i = 0; i < MAX_HIST; i++) if (histValid[i]) {
      const MeasRec& m = hist[i];
      s += U(m.id) + "," + U(m.ts) + "," + csvq(objGet(m.obj, 0)) + "," + U(m.baseId) + "," + (m.hasScore ? jnum(m.score, 1) : String("")) + "," +
           (m.hasScore ? scoreCat(m.score) : "") + "," + qName(m.quality) + "," + jnum(m.f.rms, 4) + "," + jnum(m.f.peak, 4) + "," + jnum(m.f.p2p, 4) + "," +
           jnum(m.f.sd, 4) + "," + jnum(m.f.domF, 2) + "," + jnum(m.f.fs, 2) + "," + U(m.samples);
      for (int b = 0; b < N_BANDS; b++) s += "," + jnum(m.f.band[b], 4);
      s += "\r\n";
    }
  } else {
    if (!haveWin) { sendErr(404, "No measurement data available"); return; }
    float fs = (isfinite(cur.fsEff) && cur.fsEff > 0) ? cur.fsEff : FS_NOMINAL;
    fname = "window_" + U(dataWin) + ".csv";
    s += "# window=" + U(dataWin) + " fs_hz=" + String(fs, 2) + " quality=" + qName(cur.quality) + " rms_ms2=" + jnum(cur.f.rms, 4) +
         " peak_ms2=" + jnum(cur.f.peak, 4) + " dominant_hz=" + jnum(cur.f.domF, 2) + " (acceleration: DC removed, m/s^2)\r\n";
    s += "sample,time_s,x_ms2,y_ms2,z_ms2,resultant_ms2\r\n";
    for (int i = 0; i < N_SAMP; i++) {
      s += String(i) + "," + String(i / fs, 5) + "," + String(wx[i], 4) + "," + String(wy[i], 4) + "," + String(wz[i], 4) + "," +
           String(sqrtf(wx[i] * wx[i] + wy[i] * wy[i] + wz[i] * wz[i]), 4) + "\r\n";
    }
  }
  server.sendHeader("Content-Disposition", "attachment; filename=\"" + fname + "\"");
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/csv", s);
}
void handleNotFound() { sendErr(404, "Not found or wrong HTTP method: " + server.uri()); }

// ============================ WI-FI ============================
void startAP() {
  WiFi.mode(WIFI_AP);
  delay(100);
  bool ok = WiFi.softAP(AP_SSID, AP_PASS, 1, 0, 4);
  delay(100);
  WiFi.softAPConfig(IPAddress(192, 168, 4, 1), IPAddress(192, 168, 4, 1), IPAddress(255, 255, 255, 0));
  WiFi.setSleep(false);
  Serial.printf("[WiFi] AP \"%s\" %s, IP %s\n", AP_SSID, ok ? "started" : "FAILED", WiFi.softAPIP().toString().c_str());
}
void wifiWatchdog() {
  static uint32_t t = 0;
  if (millis() - t < 5000) return;
  t = millis();
  if (acqActive) return;
  wifi_mode_t m = WiFi.getMode();
  if (m != WIFI_AP && m != WIFI_AP_STA) { Serial.println("[WiFi] AP lost - restarting"); startAP(); }
}

// ============================ SETUP / LOOP ============================
void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println("\n=== STRUCTURAL INTEGRITY MONITOR ===");
  memset(&cur, 0, sizeof(cur));
  blReset();
  dspInit();
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(400000);
  Wire.setTimeOut(50);
  loadStorage();
  sensorOk = adxlInit();
  Serial.println(sensorOk ? "[ADXL345] detected and configured (200 Hz, FULL_RES +/-4g, FIFO stream)" : "[ADXL345] NOT detected - check wiring (SDA=21 SCL=22 CS=3V3 SDO=GND)");
  startAP();

  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/status", HTTP_GET, handleStatus);
  server.on("/api/sensor", HTTP_GET, handleSensor);
  server.on("/api/data", HTTP_GET, handleData);
  server.on("/api/baseline", HTTP_GET, handleBaselineGet);
  server.on("/api/history", HTTP_GET, handleHistory);
  server.on("/api/object", HTTP_GET, handleObjectGet);
  server.on("/api/export/csv", HTTP_GET, handleExport);
  server.on("/api/test/start", HTTP_POST, handleTestStart);
  server.on("/api/test/stop", HTTP_POST, handleTestStop);
  server.on("/api/baseline/start", HTTP_POST, handleBaselineStart);
  server.on("/api/baseline/stop", HTTP_POST, handleBaselineStop);
  server.on("/api/baseline/save", HTTP_POST, handleBaselineSave);
  server.on("/api/object/save", HTTP_POST, handleObjectSave);
  server.on("/api/object/select", HTTP_POST, handleObjectSelect);
  server.on("/api/object/delete", HTTP_POST, handleObjectDelete);
  server.on("/api/history/delete", HTTP_POST, handleHistoryDelete);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("[HTTP] Dashboard: http://192.168.4.1");
}

void loop() {
  server.handleClient();
  acqPoll();
  if (acqActive && (acqDone || acqErr)) finishWindow();
  if (mode != M_IDLE && !acqActive && sensorOk && millis() - lastAcqTry > 100) {   // next window
    lastAcqTry = millis();
    if (!acqStart()) { /* sensor error: sensorIdleService will re-init */ }
  }
  sensorIdleService();
  wifiWatchdog();
  delay(1);   // 1 ms yield; the 32-sample FIFO (160 ms @200 Hz) buffers data so nothing is lost
}

