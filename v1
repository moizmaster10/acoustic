function drawCmp(){const c=$('c5');if(!D)return emptyMsg(c,'NO DATA \u2014 START A TEST');if(!D.base64)return emptyMsg(c,'BASELINE REQUIRED FOR THIS OBJECT');
 const x=D.cur64.map((_,j)=>(2*j+0.5)*D.df);plot(c,[{x,y:D.base64,color:C.bl,name:'BASELINE',lw:2},{x,y:D.cur64,color:C.or,name:'CURRENT',lw:1.6}],{xl:'frequency (Hz)',yl:'amplitude (m/s\u00B2)',y0:0});}
function drawBars(){const c=$('c6');if(!D)return emptyMsg(c,'NO DATA \u2014 START A TEST');if(!D.base)return emptyMsg(c,'BASELINE REQUIRED FOR THIS OBJECT');
 const{g,w,h}=setupCanvas(c);const it=[['RMS',D.f.rms,D.base.rms],['PEAK',D.f.peak,D.base.peak],['P2P',D.f.p2p,D.base.p2p],['SD',D.f.sd,D.base.sd],['F DOM',D.f.domF,D.base.domF]];
 for(let b=0;b<4;b++)it.push(['B'+(b+1),D.f.band[b],D.base.band[b]]);
 const n=it.length,gw=(w-16)/n,top=24,bh=h-top-40;g.font='10px ui-monospace,Consolas,monospace';g.textAlign='center';
 g.fillStyle=C.bl;g.fillText('\u25A0 BASELINE',w-120,12);g.fillStyle=C.or;g.fillText('\u25A0 CURRENT',w-50,12);
 it.forEach((m,i)=>{const mx=Math.max(m[1]||0,m[2]||0)||1,x=8+i*gw,bw=gw*0.3;
  g.fillStyle=C.bl;const hb=(m[2]||0)/mx*bh;g.fillRect(x+gw*0.15,top+bh-hb,bw,hb);
